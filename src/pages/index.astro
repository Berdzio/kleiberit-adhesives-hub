---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header";
import HeroSection from "@/components/HeroSection";
import ProductsSection from "@/components/ProductsSection";
import AboutSection from "@/components/AboutSection";
import IndustriesSection from "@/components/IndustriesSection";
import ContactSection from "@/components/ContactSection";
import Footer from "@/components/Footer";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Klejber",
  "description": "Autoryzowany dystrybutor klejów przemysłowych KLEIBERIT® w Polsce. Kleje PUR, PVAc, EVA, termotopliwe, kontaktowe i montażowe.",
  "url": "https://klejeme.pl",
  "email": "info@klejeme.pl",
  "telephone": "+48512825215",
  "brand": { "@type": "Brand", "name": "KLEIBERIT" },
  "makesOffer": [
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Kleje termotopliwe PUR" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Kleje PVAc" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Kleje termotopliwe EVA" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Kleje montażowe" } },
    { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Kleje kontaktowe" } },
  ],
};
---

<BaseLayout
  title="Klejber — Autoryzowany dystrybutor klejów KLEIBERIT® | Kleje przemysłowe"
  description="Klejber — autoryzowany dystrybutor klejów przemysłowych KLEIBERIT®. Kleje PUR, PVAc, EVA, termotopliwe, kontaktowe i montażowe dla stolarki, meblarstwa i budownictwa."
  canonical="https://klejeme.pl/"
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-background">
    <Header client:load />
    <HeroSection client:load />
    <ProductsSection client:visible />
    <AboutSection client:visible />
    <IndustriesSection client:visible />
    <ContactSection client:load />
    <Footer />
  </div>
</BaseLayout>
