---
import { sectors } from "@/data/sectors";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectorPageContent from "@/components/SectorPageContent";
import Header from "@/components/Header";
import Footer from "@/components/Footer.astro";

export function getStaticPaths() {
  return sectors.map((sector) => ({ params: { slug: sector.slug } }));
}

const { slug } = Astro.params;
const sector = sectors.find((s) => s.slug === slug);

const title = sector
  ? `Kleje do ${sector.name.toLowerCase()} KLEIBERIT® — kleje przemysłowe | Klejber`
  : "Nie znaleziono branży | Klejber kleje przemysłowe";
const description = sector
  ? `${sector.description} Autoryzowany dystrybutor klejów przemysłowych KLEIBERIT® w Polsce.`
  : "Branża nie została znaleziona.";
const canonical = `https://klejeme.pl/sector/${slug}`;

const jsonLd = sector
  ? {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: `Kleje przemysłowe do branży: ${sector.name} — Klejber`,
      description: sector.description,
      url: canonical,
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://klejeme.pl/" },
          { "@type": "ListItem", position: 2, name: "Branże", item: "https://klejeme.pl/#industries" },
          { "@type": "ListItem", position: 3, name: sector.name, item: canonical },
        ],
      },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: sector.products.map((p, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "Product",
            name: p.name,
            description: p.description,
            brand: { "@type": "Brand", name: "KLEIBERIT" },
          },
        })),
      },
    }
  : undefined;
---

<BaseLayout {title} {description} {canonical} jsonLd={jsonLd}>
  <Header client:load />
  <SectorPageContent slug={slug!} client:load />
  <Footer />
</BaseLayout>
